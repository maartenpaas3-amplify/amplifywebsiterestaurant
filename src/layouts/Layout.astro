---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { siteConfig } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, path, ogImage, jsonLd, noindex } = Astro.props;

// Wires site.config.ts's `colors` into the actual CSS custom properties
// global.css's :root block declares — WITHOUT this, changing colors in
// site.config.ts would silently do nothing (the exact same class of bug the
// order-landing-page engine had with its typography fields before that got
// fixed). This is what makes site.config.ts genuinely the one file you edit
// per client for color, not just documentation that looks like it works.
const colorOverrides = `:root{--color-primary:${siteConfig.colors.primary};--color-accent:${siteConfig.colors.accent};--color-background:${siteConfig.colors.background};}`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} jsonLd={jsonLd} noindex={noindex} />
    <style set:html={colorOverrides} />
    <!-- Fonts: same pair as the order-landing-page engine (Bodoni Moda display
         + Inter body) so the two sites read as one family. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600;6..96,700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain-overlay"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Sitewide scroll-reveal — see the [data-reveal] rules in global.css
      // for what this toggles. One observer, reused for every element with
      // the attribute, on every page (no per-page wiring needed).
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
