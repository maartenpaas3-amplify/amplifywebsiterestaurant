---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { orderCtaLabel } from '../lib/nav';
import { menuHighlights } from '../content/menu-highlights';
import { testimonials, aggregateRating } from '../content/testimonials';

const { primaryKeyword, city } = siteConfig.identity;

// Restaurant + LocalBusiness structured data — the single most important
// JSON-LD block on the whole site, since Home is what Google/AI engines
// most often use to resolve "what is this place, where is it, is it open".
const restaurantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteConfig.identity.name,
  image: new URL('/images/hero-home.jpg', siteConfig.identity.siteUrl).toString(),
  '@id': siteConfig.identity.siteUrl,
  url: siteConfig.identity.siteUrl,
  telephone: siteConfig.contact.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.contact.address,
    addressLocality: siteConfig.identity.city,
    addressCountry: siteConfig.identity.country,
  },
  servesCuisine: 'Indian',
  priceRange: '€€',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue,
    reviewCount: aggregateRating.reviewCount,
  },
};

const highlightItems = menuHighlights.flatMap((c) => c.items).slice(0, 4);

const ratingRounded = Math.round(Number(aggregateRating.ratingValue));
const ratingStars = '★'.repeat(ratingRounded) + '☆'.repeat(5 - ratingRounded);
---
<Layout
  title={`${siteConfig.identity.name} — ${primaryKeyword} à ${city}`}
  description={`${siteConfig.identity.name} est un ${primaryKeyword} authentique à ${city}. Currys, grillades tandoori et pains naan cuits minute, à commander en ligne ou sur place.`}
  path="/"
  ogImage="/images/hero-home.jpg"
  jsonLd={restaurantJsonLd}
>
  <!-- Hero -->
  <section class="relative min-h-[640px] sm:h-[92vh] flex items-end sm:items-center overflow-hidden">
    <img src="/images/hero-home.jpg" alt={`Salle et plats du ${primaryKeyword} ${siteConfig.identity.name}`} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0" style="background: linear-gradient(0deg, var(--color-background) 15%, rgba(11,11,12,0.35) 55%, rgba(11,11,12,0.55) 100%)"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-16 sm:pb-0 w-full">
      <div class="max-w-xl">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.3em] mb-4" style="color: var(--color-accent)">
          {siteConfig.identity.city} · {siteConfig.identity.country}
        </span>
        <h1 class="font-display text-[2.4rem] leading-[1.05] sm:text-5xl lg:text-6xl font-semibold tracking-tight" style="color: var(--color-text-primary)">
          {siteConfig.identity.name} — {primaryKeyword} authentique à {city}
        </h1>
        <p class="mt-5 text-base sm:text-lg max-w-md" style="color: var(--color-text-muted)">
          Currys onctueux, grillades au tandoor traditionnel et pains naan cuits minute, au cœur de la ville.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={orderCtaLabel.href} external variant="cta">{orderCtaLabel.label}</Button>
          <Button href="/menu" variant="outline">Voir le menu</Button>
        </div>
        <!-- Trust signal, moved above the fold instead of halfway down the
             page — a real, sourced rating (Tripadvisor, not invented and
             not attributed to Google since that's not where it's from). -->
        <p class="mt-5 flex items-center gap-2 text-sm" style="color: var(--color-text-muted)">
          <span style="color: var(--color-accent); letter-spacing: 1px">{ratingStars}</span>
          {aggregateRating.ratingValue}/5 · {aggregateRating.reviewCount} avis Tripadvisor
        </p>
      </div>
    </div>
  </section>

  <!-- Menu highlights — the red accent bar + circular price badge from the
       previous pass read as a coupon-site sticker, not premium ("goedkoop"
       per direct feedback). Reverted to the clean gold-only card, kept the
       one thing that genuinely helps (the lotus glyph, small and quiet)
       and the price now just underlines on hover instead of shouting from
       a badge — motion carries the interest, not an extra color. -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <div class="flex items-baseline justify-between mb-8 pb-3" style="border-bottom: 1px solid var(--color-border)">
      <div>
        <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-1" style="color: var(--color-accent)">Sélection</span>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">Nos incontournables</h2>
      </div>
      <a href="/menu" class="text-sm font-bold" style="color: var(--color-accent)">Menu complet →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {highlightItems.map((item, i) => (
        <div
          class="card-lift rounded-2xl p-5"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 80}ms`}
          data-reveal
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="mb-3" style="color: var(--color-accent); opacity: 0.75">
            <path d="M12 3c-1.5 3-4.5 4.5-4.5 8.5a4.5 4.5 0 009 0C16.5 7.5 13.5 6 12 3z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
          </svg>
          <h3 class="menu-item-name font-display font-semibold text-lg" style="color: var(--color-text-primary)">{item.name}</h3>
          <p class="text-sm mt-1.5 leading-relaxed" style="color: var(--color-text-muted)">{item.description}</p>
          <p class="menu-item-price mt-3 font-bold" style="color: var(--color-accent)">{item.priceMAD} MAD</p>
        </div>
      ))}
    </div>
  </section>

  <Ornament />

  <!-- Signature spotlight v2 — the split photo/text-panel version read as
       two flat boxes stitched together ("raar en saai"). This is the "wow"
       pick from the 3 options: one continuous full-bleed image with a slow
       cinematic Ken Burns zoom (pure CSS, no video asset needed — this is
       the wow-factor option that's actually buildable with the photos we
       have), text overlaid directly on the image via a gradient scrim
       instead of sitting in its own flat-color panel. Deliberately still
       ONE dish (not a crossfade between different dishes) — the caption is
       specific to the biryani, so the photo has to match it the whole
       time. -->
  <section class="relative min-h-[480px] sm:h-[78vh] overflow-hidden" data-reveal="scale">
    <div class="ken-burns absolute inset-0">
      <img
        src="/images/gallery-biryani.jpg"
        alt={`Biryani et sélection de plats servis chez ${siteConfig.identity.name}`}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <!-- Scrim now leans warm instead of flat black — a subtle wine tint
         mixed in via the same --color-primary-dark token as the footer
         glow and the new warm section bands, so the "signature dish"
         moment carries a touch of the order-engine's palette instead of
         a generic dark gradient. -->
    <div class="absolute inset-0" style="background: linear-gradient(100deg, color-mix(in srgb, var(--color-primary-dark) 30%, var(--color-background)) 0%, color-mix(in srgb, var(--color-primary-dark) 16%, rgba(11,11,12,0.55)) 42%, rgba(11,11,12,0.15) 68%, transparent 100%)"></div>

    <div class="relative z-10 h-full flex items-center max-w-7xl mx-auto px-5 sm:px-8">
      <div class="max-w-md">
        <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-4" style="color: var(--color-accent)">Plat signature</span>
        <p class="pull-quote">
          Un Hyderabadi Dum Biryani mijoté à l'étouffée, servi avec pani puri et naan tout juste sorti du tandoor.
        </p>
        <a href="/menu" class="inline-block mt-6 text-sm font-bold" style="color: var(--color-accent)">Voir le menu complet →</a>
      </div>
    </div>
  </section>

  <!-- Photo gallery — real photos of the food and the restaurant, not stock
       imagery. This is deliberately placed high on the page: per the
       standing SEO notes in site.config.ts, real original photography does
       more for trust (E-E-A-T) than any meta tag or structured-data trick
       combined. Three real shots today; add more here as the client
       supplies them — this grid scales past 3 without changes. -->
  <div class="section-tint">
    <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
        <div class="photo-frame rounded-2xl col-span-2 sm:col-span-1 aspect-square" data-reveal="scale">
          <img src="/images/gallery-curries.jpg" alt={`Plats de ${siteConfig.identity.name}, ${primaryKeyword} à ${city}`} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="photo-frame rounded-2xl aspect-square" data-reveal="scale" style="transition-delay: 100ms">
          <img src="/images/gallery-naan.jpg" alt="Naan fait maison, cuit au tandoor" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="photo-frame rounded-2xl aspect-square" data-reveal="scale" style="transition-delay: 200ms">
          <img src="/images/gallery-spread.jpg" alt="Sélection d'entrées et de plats indiens" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>
  </div>

  <!-- Why us / E-E-A-T signals -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 grid sm:grid-cols-3 gap-8">
    {[
      {
        title: 'Recettes authentiques',
        body: "Épices importées, recettes transmises depuis trois générations, sans compromis sur le goût.",
        icon: 'M12 2c-1 3-4 4-4 8a4 4 0 008 0c0-4-3-5-4-8zM6 20h12',
      },
      {
        title: 'Tandoor traditionnel',
        body: "Cuisson au four d'argile pour nos grillades et nos pains naan, cuits minute à la commande.",
        icon: 'M5 21V9a7 7 0 0114 0v12M5 21h14M9 21v-6h6v6',
      },
      {
        title: 'Livraison rapide',
        body: `Commande directement reliée à notre cuisine à ${siteConfig.identity.city} — préparation immédiate.`,
        icon: 'M3 7h11v8H3zM14 10h4l3 3v2h-7zM6 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z',
      },
    ].map((f, i) => (
      <div data-reveal style={`transition-delay: ${i * 100}ms`}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="mb-4" style="color: var(--color-accent)">
          <path d={f.icon} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h3 class="font-display text-xl font-semibold mb-2" style="color: var(--color-text-primary)">{f.title}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{f.body}</p>
      </div>
    ))}
  </section>

  <!-- Testimonial carousel — the single static quote read as "text
       floating in an empty room" ("raar en saai"). This is the wow-factor
       pick: cycles through ALL real reviews (not just one), each with a
       gold monogram instead of a generic quotation mark, auto-advancing
       with dot controls. No fabricated customer photos — the monogram is
       honest (just the reviewer's first initial) rather than pretending we
       have portraits we don't. Pure vanilla JS, ~20 lines, no framework. -->
  <section class="section-tint-warm relative max-w-none px-0 py-16 sm:py-28 overflow-hidden" data-reveal>
    <div class="section-glow" style="width: 380px; height: 380px; background: var(--color-accent); opacity: 0.14; right: -140px; bottom: -60px;"></div>

    <div class="relative testimonial-carousel max-w-3xl mx-auto px-5 sm:px-8">
      <div class="testimonial-track">
        {testimonials.map((t, i) => (
          <div class="testimonial-slide text-center" data-slide={i}>
            <span
              class="inline-flex items-center justify-center w-12 h-12 rounded-full font-display font-bold text-lg mb-5"
              style="background: var(--color-surface); border: 1.5px solid var(--color-accent); color: var(--color-accent)"
            >
              {t.name.charAt(0)}
            </span>
            <p class="pull-quote">{t.text}</p>
            <p class="mt-6 text-sm font-bold" style="color: var(--color-accent)">— {t.name}</p>
          </div>
        ))}
      </div>

      <div class="testimonial-dots flex items-center justify-center gap-2 mt-8">
        {testimonials.map((_, i) => (
          <button
            type="button"
            class="testimonial-dot w-2 h-2 rounded-full transition-all"
            style="background-color: var(--color-border)"
            data-dot={i}
            aria-label={`Avis ${i + 1}`}
          ></button>
        ))}
      </div>

      <p class="text-center mt-4">
        <a href="/avis" class="text-sm font-bold" style="color: var(--color-accent)">Lire tous les avis →</a>
      </p>
    </div>
  </section>

  <style>
    .testimonial-track { position: relative; min-height: 220px; }
    .testimonial-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }
    .testimonial-slide.is-active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .testimonial-dot.is-active { background-color: var(--color-accent) !important; width: 22px; }
  </style>

  <script>
    document.querySelectorAll<HTMLElement>('.testimonial-carousel').forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-dot'));
      let active = 0;
      let timer: ReturnType<typeof setInterval>;

      function show(index: number) {
        active = (index + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
        dots.forEach((d, i) => d.classList.toggle('is-active', i === active));
      }
      function start() {
        timer = setInterval(() => show(active + 1), 6000);
      }
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          clearInterval(timer);
          start();
        });
      });
      show(0);
      start();
    });
  </script>
</Layout>
