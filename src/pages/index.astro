---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site.config';
import { orderCtaLabel } from '../lib/nav';
import { menuHighlights } from '../content/menu-highlights';
import { testimonials } from '../content/testimonials';

const { primaryKeyword, city } = siteConfig.identity;

// Restaurant + LocalBusiness structured data — the single most important
// JSON-LD block on the whole site, since Home is what Google/AI engines
// most often use to resolve "what is this place, where is it, is it open".
const restaurantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteConfig.identity.name,
  image: new URL('/images/hero-home.jpg', siteConfig.identity.siteUrl).toString(),
  '@id': siteConfig.identity.siteUrl,
  url: siteConfig.identity.siteUrl,
  telephone: siteConfig.contact.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.contact.address,
    addressLocality: siteConfig.identity.city,
    addressCountry: siteConfig.identity.country,
  },
  servesCuisine: 'Indian',
  priceRange: '€€',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: String(testimonials.length),
  },
};

const highlightItems = menuHighlights.flatMap((c) => c.items).slice(0, 4);
---
<Layout
  title={`${siteConfig.identity.name} — ${primaryKeyword} à ${city}`}
  description={`${siteConfig.identity.name} est un ${primaryKeyword} authentique à ${city}. Currys, grillades tandoori et pains naan cuits minute, à commander en ligne ou sur place.`}
  path="/"
  ogImage="/images/hero-home.jpg"
  jsonLd={restaurantJsonLd}
>
  <!-- Hero -->
  <section class="relative min-h-[640px] sm:h-[92vh] flex items-end sm:items-center overflow-hidden">
    <img src="/images/hero-home.jpg" alt={`Salle et plats du ${primaryKeyword} ${siteConfig.identity.name}`} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0" style="background: linear-gradient(0deg, var(--color-background) 15%, rgba(11,11,12,0.35) 55%, rgba(11,11,12,0.55) 100%)"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-16 sm:pb-0 w-full">
      <div class="max-w-xl">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.3em] mb-4" style="color: var(--color-accent)">
          {siteConfig.identity.city} · {siteConfig.identity.country}
        </span>
        <h1 class="font-display text-[2.4rem] leading-[1.05] sm:text-5xl lg:text-6xl font-semibold tracking-tight" style="color: var(--color-text-primary)">
          {siteConfig.identity.name} — {primaryKeyword} authentique à {city}
        </h1>
        <p class="mt-5 text-base sm:text-lg max-w-md" style="color: var(--color-text-muted)">
          Currys onctueux, grillades au tandoor traditionnel et pains naan cuits minute, au cœur de la ville.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={orderCtaLabel.href} external>{orderCtaLabel.label}</Button>
          <Button href="/menu" variant="filled">Voir le menu</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Menu highlights -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <div class="flex items-baseline justify-between mb-8 pb-3" style="border-bottom: 1px solid var(--color-border)">
      <div>
        <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-1" style="color: var(--color-accent)">Sélection</span>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">Nos incontournables</h2>
      </div>
      <a href="/menu" class="text-sm font-bold" style="color: var(--color-accent)">Menu complet →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {highlightItems.map((item) => (
        <div class="rounded-2xl p-5" style="background-color: var(--color-surface); border: 1px solid var(--color-border)">
          <h3 class="font-display font-semibold text-lg" style="color: var(--color-text-primary)">{item.name}</h3>
          <p class="text-sm mt-1.5 leading-relaxed" style="color: var(--color-text-muted)">{item.description}</p>
          <p class="mt-3 font-bold" style="color: var(--color-accent)">{item.priceMAD} MAD</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Why us / E-E-A-T signals -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 grid sm:grid-cols-3 gap-8">
    {[
      { title: 'Recettes authentiques', body: "Épices importées, recettes transmises depuis trois générations, sans compromis sur le goût." },
      { title: 'Tandoor traditionnel', body: "Cuisson au four d'argile pour nos grillades et nos pains naan, cuits minute à la commande." },
      { title: 'Livraison rapide', body: `Commande directement reliée à notre cuisine à ${siteConfig.identity.city} — préparation immédiate.` },
    ].map((f) => (
      <div>
        <h3 class="font-display text-xl font-semibold mb-2" style="color: var(--color-text-primary)">{f.title}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{f.body}</p>
      </div>
    ))}
  </section>

  <!-- Testimonial teaser -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <div class="rounded-2xl p-8 sm:p-12" style="background-color: var(--color-surface); border: 1px solid var(--color-border)">
      <p class="font-display text-xl sm:text-2xl leading-snug" style="color: var(--color-text-primary)">
        "{testimonials[0].text}"
      </p>
      <p class="mt-4 text-sm font-bold" style="color: var(--color-accent)">— {testimonials[0].name}</p>
      <a href="/avis" class="inline-block mt-6 text-sm font-bold" style="color: var(--color-accent)">Lire tous les avis →</a>
    </div>
  </section>
</Layout>
