---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { orderCtaLabel } from '../lib/nav';
import { menuHighlights } from '../content/menu-highlights';
import { testimonials, aggregateRating } from '../content/testimonials';

const { primaryKeyword, city } = siteConfig.identity;

// Restaurant + LocalBusiness structured data — the single most important
// JSON-LD block on the whole site, since Home is what Google/AI engines
// most often use to resolve "what is this place, where is it, is it open".
const restaurantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteConfig.identity.name,
  image: new URL('/images/hero-home.jpg', siteConfig.identity.siteUrl).toString(),
  '@id': siteConfig.identity.siteUrl,
  url: siteConfig.identity.siteUrl,
  telephone: siteConfig.contact.phoneDisplay,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.contact.address,
    addressLocality: siteConfig.identity.city,
    addressCountry: siteConfig.identity.country,
  },
  servesCuisine: 'Indian',
  priceRange: '€€',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue,
    reviewCount: aggregateRating.reviewCount,
  },
};

const highlightItems = menuHighlights.flatMap((c) => c.items).slice(0, 4);
---
<Layout
  title={`${siteConfig.identity.name} — ${primaryKeyword} à ${city}`}
  description={`${siteConfig.identity.name} est un ${primaryKeyword} authentique à ${city}. Currys, grillades tandoori et pains naan cuits minute, à commander en ligne ou sur place.`}
  path="/"
  ogImage="/images/hero-home.jpg"
  jsonLd={restaurantJsonLd}
>
  <!-- Hero -->
  <section class="relative min-h-[640px] sm:h-[92vh] flex items-end sm:items-center overflow-hidden">
    <img src="/images/hero-home.jpg" alt={`Salle et plats du ${primaryKeyword} ${siteConfig.identity.name}`} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0" style="background: linear-gradient(0deg, var(--color-background) 15%, rgba(11,11,12,0.35) 55%, rgba(11,11,12,0.55) 100%)"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-16 sm:pb-0 w-full">
      <div class="max-w-xl">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.3em] mb-4" style="color: var(--color-accent)">
          {siteConfig.identity.city} · {siteConfig.identity.country}
        </span>
        <h1 class="font-display text-[2.4rem] leading-[1.05] sm:text-5xl lg:text-6xl font-semibold tracking-tight" style="color: var(--color-text-primary)">
          {siteConfig.identity.name} — {primaryKeyword} authentique à {city}
        </h1>
        <p class="mt-5 text-base sm:text-lg max-w-md" style="color: var(--color-text-muted)">
          Currys onctueux, grillades au tandoor traditionnel et pains naan cuits minute, au cœur de la ville.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={orderCtaLabel.href} external variant="cta">{orderCtaLabel.label}</Button>
          <Button href="/menu" variant="outline">Voir le menu</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Menu highlights — redesigned: a red-to-gold accent bar per card (the
       first real use of the brand's primary red anywhere on the site
       outside the logo), the price as an overlapping circular badge
       instead of a flat line of text, and a small lotus glyph standing in
       for a dish photo we don't have yet. Was previously an identical grey
       box repeated 4x with only text inside — this is the section a
       visitor sees right after the hero, it shouldn't read as a spec
       sheet. -->
  <section class="relative max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 overflow-hidden">
    <div class="section-glow" style="width: 420px; height: 420px; background: var(--color-primary); opacity: 0.14; left: -160px; top: 40px;"></div>
    <div class="relative flex items-baseline justify-between mb-8 pb-3" style="border-bottom: 1px solid var(--color-border)">
      <div>
        <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-1" style="color: var(--color-accent)">Sélection</span>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">Nos incontournables</h2>
      </div>
      <a href="/menu" class="text-sm font-bold" style="color: var(--color-accent)">Menu complet →</a>
    </div>
    <div class="relative grid sm:grid-cols-2 lg:grid-cols-4 gap-5 pt-2">
      {highlightItems.map((item, i) => (
        <div
          class="card-lift relative rounded-2xl pt-6 px-5 pb-5 overflow-visible"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 80}ms`}
          data-reveal
        >
          <span class="absolute top-0 left-5 right-5 h-[3px] rounded-full" style="background: linear-gradient(90deg, var(--color-primary), var(--color-accent))"></span>
          <span
            class="absolute -top-4 right-4 flex items-center justify-center w-14 h-14 rounded-full font-display font-bold text-sm text-center leading-tight"
            style="background: var(--color-background); border: 1px solid var(--color-border); color: var(--color-accent); box-shadow: 0 6px 16px rgba(0,0,0,0.35)"
          >
            {item.priceMAD}<br />MAD
          </span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="mb-2" style="color: var(--color-accent); opacity: 0.8">
            <path d="M12 3c-1.5 3-4.5 4.5-4.5 8.5a4.5 4.5 0 009 0C16.5 7.5 13.5 6 12 3z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
          </svg>
          <h3 class="font-display font-semibold text-lg pr-10" style="color: var(--color-text-primary)">{item.name}</h3>
          <p class="text-sm mt-1.5 leading-relaxed" style="color: var(--color-text-muted)">{item.description}</p>
        </div>
      ))}
    </div>
  </section>

  <Ornament />

  <!-- Signature spotlight — the one deliberately asymmetric, full-bleed
       moment on the page. Every other section on this site (and every
       other page) is a centered max-w-7xl container of same-size boxes;
       repeating that rhythm forever reads as flat no matter how polished
       each box is. This breaks the grid on purpose, the same way the
       order-engine's ParallaxHero breaks from centered-hero convention —
       full-width photo on one side, a real editorial pull-quote on the
       other, no card/border around either. -->
  <section class="grid sm:grid-cols-2 min-h-[420px] sm:h-[70vh]">
    <div class="photo-frame relative overflow-hidden" data-reveal="scale">
      <img
        src="/images/gallery-biryani.jpg"
        alt={`Biryani et sélection de plats servis chez ${siteConfig.identity.name}`}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="flex items-center px-5 sm:px-12 py-12 sm:py-0" style="background-color: var(--color-surface)">
      <div data-reveal>
        <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-4" style="color: var(--color-accent)">Plat signature</span>
        <p class="pull-quote">
          Un Hyderabadi Dum Biryani mijoté à l'étouffée, servi avec pani puri et naan tout juste sorti du tandoor.
        </p>
        <a href="/menu" class="inline-block mt-6 text-sm font-bold" style="color: var(--color-accent)">Voir le menu complet →</a>
      </div>
    </div>
  </section>

  <!-- Photo gallery — real photos of the food and the restaurant, not stock
       imagery. This is deliberately placed high on the page: per the
       standing SEO notes in site.config.ts, real original photography does
       more for trust (E-E-A-T) than any meta tag or structured-data trick
       combined. Three real shots today; add more here as the client
       supplies them — this grid scales past 3 without changes. -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
      <div class="photo-frame rounded-2xl col-span-2 sm:col-span-1 aspect-square" data-reveal="scale">
        <img src="/images/gallery-curries.jpg" alt={`Plats de ${siteConfig.identity.name}, ${primaryKeyword} à ${city}`} class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="photo-frame rounded-2xl aspect-square" data-reveal="scale" style="transition-delay: 100ms">
        <img src="/images/gallery-naan.jpg" alt="Naan fait maison, cuit au tandoor" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="photo-frame rounded-2xl aspect-square" data-reveal="scale" style="transition-delay: 200ms">
        <img src="/images/gallery-spread.jpg" alt="Sélection d'entrées et de plats indiens" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Why us / E-E-A-T signals -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24 grid sm:grid-cols-3 gap-8">
    {[
      {
        title: 'Recettes authentiques',
        body: "Épices importées, recettes transmises depuis trois générations, sans compromis sur le goût.",
        icon: 'M12 2c-1 3-4 4-4 8a4 4 0 008 0c0-4-3-5-4-8zM6 20h12',
      },
      {
        title: 'Tandoor traditionnel',
        body: "Cuisson au four d'argile pour nos grillades et nos pains naan, cuits minute à la commande.",
        icon: 'M5 21V9a7 7 0 0114 0v12M5 21h14M9 21v-6h6v6',
      },
      {
        title: 'Livraison rapide',
        body: `Commande directement reliée à notre cuisine à ${siteConfig.identity.city} — préparation immédiate.`,
        icon: 'M3 7h11v8H3zM14 10h4l3 3v2h-7zM6 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z',
      },
    ].map((f, i) => (
      <div data-reveal style={`transition-delay: ${i * 100}ms`}>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="mb-4" style="color: var(--color-accent)">
          <path d={f.icon} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h3 class="font-display text-xl font-semibold mb-2" style="color: var(--color-text-primary)">{f.title}</h3>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{f.body}</p>
      </div>
    ))}
  </section>

  <!-- Testimonial teaser — deliberately unboxed: after three sections of
       cards-in-a-grid, a large pull-quote with no border/background reads
       as an editorial break rather than "one more grey box". -->
  <section class="relative max-w-3xl mx-auto px-5 sm:px-8 py-16 sm:py-28 text-center overflow-hidden" data-reveal>
    <div class="section-glow" style="width: 380px; height: 380px; background: var(--color-accent); opacity: 0.1; right: -140px; bottom: -60px;"></div>
    <span class="relative font-display block text-6xl leading-none mb-2" style="color: var(--color-accent)">"</span>
    <p class="relative pull-quote -mt-6">
      {testimonials[0].text}
    </p>
    <p class="relative mt-6 text-sm font-bold" style="color: var(--color-accent)">— {testimonials[0].name}</p>
    <a href="/avis" class="relative inline-block mt-4 text-sm font-bold" style="color: var(--color-accent)">Lire tous les avis →</a>
  </section>
</Layout>
