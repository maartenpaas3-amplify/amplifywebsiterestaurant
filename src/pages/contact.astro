---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site.config';
import { orderCtaLabel } from '../lib/nav';

const { primaryKeyword, name, city } = siteConfig.identity;

// Same small-icon language used everywhere else on the site by now (Home's
// "why us", the À propos stats, the FAQ categories) — Contact was the one
// info block left as three identical label-over-value stacks with nothing
// to anchor the eye.
const infoItems = [
  { label: 'Adresse', value: siteConfig.contact.address, href: undefined, icon: 'M12 21s7-7.58 7-12A7 7 0 105 9c0 4.42 7 12 7 12z M12 11a2 2 0 100-4 2 2 0 000 4z' },
  { label: 'Téléphone', value: siteConfig.contact.phoneDisplay, href: siteConfig.contact.phoneHref, icon: 'M4 4h4l2 5-2.5 1.5a11 11 0 005 5L14 13l5 2v4a2 2 0 01-2 2A15 15 0 014 6a2 2 0 012-2z' },
  { label: 'Horaires', value: siteConfig.contact.openingHours, href: undefined, icon: 'M12 7v5l3 3 M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---
<Layout
  title={`Contact & horaires — ${primaryKeyword} à ${city} | ${name}`}
  description={`Adresse, téléphone et horaires de ${name}, ${primaryKeyword} à ${city}. ${siteConfig.contact.address}.`}
  path="/contact"
>
  <PageHero kicker={city} title="Contact & horaires" image="/images/gallery-curries.jpg" alt={`Plats de ${name}`} />

  <!-- Typographic moment instead of jumping straight from the photo hero
       into a form-like two-column block — same unboxed pull-quote language
       used on Home/Avis, single-sourced from siteConfig so it can't drift
       from the real opening hours. -->
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-6" data-reveal>
    <p class="pull-quote max-w-2xl">
      Une question, une envie de curry ce soir ? {siteConfig.contact.openingHours}.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-4 pb-20 grid sm:grid-cols-2 gap-12">
    <div>
      <div class="space-y-5 text-sm sm:text-base" style="color: var(--color-text-primary)">
        {infoItems.map((item, i) => (
          <div class="flex items-start gap-3" data-reveal style={`transition-delay: ${i * 80}ms`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.6" class="shrink-0 mt-0.5" style="color: var(--color-accent)">
              <path d={item.icon} stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <p class="font-bold text-xs uppercase tracking-wide" style="color: var(--color-text-muted)">{item.label}</p>
              {item.href ? (
                <a href={item.href} class="mt-1 inline-block hover:underline">{item.value}</a>
              ) : (
                <p class="mt-1">{item.value}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={orderCtaLabel.href} external variant="cta">{orderCtaLabel.label}</Button>
        {siteConfig.contact.mapsUrl && (
          <Button href={siteConfig.contact.mapsUrl} external variant="filled">Itinéraire</Button>
        )}
      </div>
    </div>

    <!-- Warm-tinted instead of the plain neutral surface every other card
         on the site used to have — same color-mix token as the section
         bands, so the map doesn't sit as an isolated grey block next to
         text that's now part of the site's warmer rhythm. -->
    <div
      class="rounded-2xl overflow-hidden aspect-[4/3] sm:aspect-auto"
      style="background-color: color-mix(in srgb, var(--color-primary-dark) 10%, var(--color-surface)); border: 1px solid var(--color-border)"
      data-reveal
    >
      <iframe
        src={`https://www.google.com/maps?q=${encodeURIComponent(siteConfig.contact.address)}&output=embed`}
        class="w-full h-full grayscale-[35%] contrast-[1.05]"
        style="border: 0; min-height: 260px;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Carte — ${name}, ${siteConfig.contact.address}`}
      ></iframe>
    </div>
  </section>
</Layout>
