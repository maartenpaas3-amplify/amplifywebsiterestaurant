---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { testimonials, aggregateRating } from '../content/testimonials';

const { primaryKeyword, name, city } = siteConfig.identity;
const avg = aggregateRating.ratingValue;

// Individual Review + AggregateRating JSON-LD, on-domain — the standing note
// in site.config.ts explains why: AI answer engines scan review PAGES for
// recommendations, not just the Google Business Profile listing itself.
// aggregateRating comes from testimonials.ts's REAL, external rating — not
// computed from the (curated, mostly-positive) selection shown below. See
// the comment there for why that distinction matters.
const reviewsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: aggregateRating.ratingValue,
    reviewCount: aggregateRating.reviewCount,
  },
  review: testimonials.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.name },
    datePublished: t.date,
    reviewRating: { '@type': 'Rating', ratingValue: String(t.rating), bestRating: '5' },
    reviewBody: t.text,
  })),
};

const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Layout
  title={`Avis clients — ${primaryKeyword} à ${city} | ${name}`}
  description={`Ce que disent nos clients de ${name}, ${primaryKeyword} à ${city} : note moyenne ${avg}/5 sur ${aggregateRating.reviewCount} avis vérifiés.`}
  path="/avis"
  jsonLd={reviewsJsonLd}
>
  <PageHero kicker={city} title="Avis clients" image="/images/gallery-naan.jpg" alt={`Plat servi chez ${name}`} />
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-10 sm:pt-12 pb-8">
    <p class="text-lg" style="color: var(--color-accent)">
      {stars(Math.round(Number(avg)))} <span style="color: var(--color-text-muted)">{avg}/5 · {aggregateRating.reviewCount} avis</span>
    </p>
  </section>

  <!-- The single best review, set as an unboxed pull-quote — a deliberate
       "wow" moment before the page drops into the regular grid of shorter
       cards below, instead of every review getting equal, flat weight. -->
  {testimonials[0] && (
    <section class="relative max-w-3xl mx-auto px-5 sm:px-8 pb-16 text-center overflow-hidden" data-reveal>
      <div class="section-glow" style="width: 360px; height: 360px; background: var(--color-primary); opacity: 0.12; left: -120px; top: -40px;"></div>
      <span class="relative font-display block text-6xl leading-none mb-2" style="color: var(--color-accent)">"</span>
      <p class="relative pull-quote -mt-6">{testimonials[0].text}</p>
      <p class="relative mt-6 text-sm font-bold" style="color: var(--color-accent)">
        {testimonials[0].name} · {stars(testimonials[0].rating)}
      </p>
      {testimonials[0].sourceUrl && (
        <a href={testimonials[0].sourceUrl} target="_blank" rel="noreferrer" class="relative inline-block mt-3 text-sm font-bold" style="color: var(--color-text-muted)">
          Voir tous les avis sur Tripadvisor →
        </a>
      )}
    </section>
  )}

  <Ornament />

  <section class="max-w-4xl mx-auto px-5 sm:px-8 pb-20 grid sm:grid-cols-2 gap-5">
    {testimonials.slice(1).map((t, i) => (
      <div
        class="card-lift rounded-xl p-5"
        style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 80}ms`}
        data-reveal
      >
        <p class="text-sm" style="color: var(--color-accent)">{stars(t.rating)}</p>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-primary)">"{t.text}"</p>
        <p class="mt-3 text-xs font-bold" style="color: var(--color-text-muted)">
          {t.name} · {new Date(t.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' })}
          {t.sourceUrl && (
            <a href={t.sourceUrl} target="_blank" rel="noreferrer" class="ml-1 font-normal underline" style="color: var(--color-text-muted)">
              (Tripadvisor)
            </a>
          )}
        </p>
      </div>
    ))}
  </section>

  <section class="max-w-4xl mx-auto px-5 sm:px-8 pb-20 text-center">
    <Button href="/menu" variant="filled">Découvrir le menu</Button>
  </section>
</Layout>
