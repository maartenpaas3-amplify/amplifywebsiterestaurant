---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site.config';
import { orderCtaLabel } from '../lib/nav';
import { menuHighlights } from '../content/menu-highlights';

const { primaryKeyword, name, city } = siteConfig.identity;

const menuJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menu — ${name}`,
  hasMenuSection: menuHighlights.map((cat) => ({
    '@type': 'MenuSection',
    name: cat.label,
    hasMenuItem: cat.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      description: item.description,
      offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
    })),
  })),
};
---
<Layout
  title={`Menu — ${primaryKeyword} à ${city} | ${name}`}
  description={`Découvrez le menu complet de ${name}, ${primaryKeyword} à ${city} : entrées, plats tandoori, biryani et pains naan. Commandez en ligne ou sur place.`}
  path="/menu"
  jsonLd={menuJsonLd}
>
  <PageHero
    kicker={city}
    title={`Le menu de notre ${primaryKeyword}`}
    subtitle="Une sélection de nos plats signature. Le menu complet, avec toutes les options et suppléments, est disponible au moment de la commande."
    image="/images/gallery-spread.jpg"
    alt={`Plats du menu de ${siteConfig.identity.name}`}
  />
  <section class="max-w-7xl mx-auto px-5 sm:px-8 pt-8 pb-8">
    <div>
      <Button href={orderCtaLabel.href} external>{orderCtaLabel.label}</Button>
    </div>
  </section>

  {menuHighlights.map((category, i) => (
    <section class="max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class={category.image ? 'grid sm:grid-cols-[minmax(0,15rem)_1fr] gap-6 sm:gap-8 items-start' : ''}>
        {category.image && (
          <div class="photo-frame rounded-2xl overflow-hidden aspect-[4/3] sm:aspect-square" data-reveal="scale">
            <img src={category.image} alt={category.imageAlt ?? category.label} class="w-full h-full object-cover" loading="lazy" />
          </div>
        )}
        <div>
          <h2
            class="font-display text-2xl font-semibold mb-5 pb-3 flex items-baseline gap-3"
            style="color: var(--color-text-primary); border-bottom: 1px solid var(--color-border)"
          >
            <span class="text-xs font-bold" style="color: var(--color-accent)">{String(i + 1).padStart(2, '0')}</span>
            {category.label}
          </h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {category.items.map((item, j) => (
              <div
                class="card-lift flex items-start justify-between gap-4 rounded-xl p-4"
                style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
                data-reveal
              >
                <div>
                  <h3 class="font-display font-semibold" style="color: var(--color-text-primary)">{item.name}</h3>
                  <p class="text-sm mt-1" style="color: var(--color-text-muted)">{item.description}</p>
                </div>
                <span class="font-bold shrink-0" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 text-center">
    <p class="text-sm mb-4" style="color: var(--color-text-muted)">Prêt à commander ?</p>
    <Button href={orderCtaLabel.href} external>{orderCtaLabel.label}</Button>
  </section>
</Layout>
