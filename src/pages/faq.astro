---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';
import { faqItems } from '../content/faq';

const { primaryKeyword, name, city } = siteConfig.identity;

// FAQPage JSON-LD — this is the block AI answer engines (ChatGPT, Google AI
// Overviews, Perplexity) most directly lift answers/citations from. Built
// straight off faqItems so the visible page and the structured data can
// never drift out of sync with each other.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<Layout
  title={`Questions fréquentes — ${primaryKeyword} à ${city} | ${name}`}
  description={`Horaires, livraison, réservations : les réponses aux questions les plus fréquentes sur ${name}, ${primaryKeyword} à ${city}.`}
  path="/faq"
  jsonLd={faqJsonLd}
>
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-28 sm:pt-36 pb-20">
    <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-2" style="color: var(--color-accent)">Besoin d'aide ?</span>
    <h1 class="font-display text-3xl sm:text-5xl font-semibold mb-10" style="color: var(--color-text-primary)">
      Questions fréquentes
    </h1>

    <div class="space-y-3">
      {faqItems.map((item, i) => (
        <details class="group rounded-xl px-5 py-4" style="background-color: var(--color-surface); border: 1px solid var(--color-border)" open={i === 0}>
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-display font-semibold" style="color: var(--color-text-primary)">
            {item.question}
            <span class="shrink-0 text-lg transition-transform group-open:rotate-45" style="color: var(--color-accent)">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted)">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
