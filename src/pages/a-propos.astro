---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site.config';
import { aggregateRating } from '../content/testimonials';

const { primaryKeyword, name, city } = siteConfig.identity;
---
<Layout
  title={`À propos — ${name}, ${primaryKeyword} à ${city}`}
  description={`L'histoire de ${name}, ${primaryKeyword} à ${city} : recettes familiales, épices importées et cuisson au tandoor traditionnel.`}
  path="/a-propos"
>
  <PageHero
    kicker="Notre histoire"
    title={`À propos de ${name}`}
    image="/images/interior-1.jpg"
    alt={`Intérieur du ${primaryKeyword} ${name}`}
  />
  <section class="max-w-3xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-20">
    <div class="space-y-5 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
      <p>
        {name} est né d'une conviction simple : {city} méritait un {primaryKeyword} qui ne transige ni sur les
        épices, ni sur les techniques de cuisson traditionnelles. Pas de recettes édulcorées pour le marché local —
        le même goût que celui que l'on trouve dans les cuisines familiales du nord de l'Inde.
      </p>
      <p>
        Notre four tandoor en argile, chauffé au charbon, est au centre de la cuisine : c'est lui qui donne aux
        pains naan leur croûte caractéristique et aux grillades leur fumé si particulier. Chaque plat est préparé à
        la commande, jamais à l'avance.
      </p>
      <p>
        Les épices sont importées directement, moulues sur place, et nos recettes suivent celles transmises depuis
        plusieurs générations. C'est ce soin, plus que n'importe quel argument marketing, qui fait revenir nos
        clients.
      </p>
    </div>

    <div class="mt-10 grid sm:grid-cols-3 gap-6">
      {[
        { n: '10+', l: "ans d'expérience en cuisine indienne" },
        { n: '100%', l: 'plats préparés à la commande' },
        { n: `${aggregateRating.ratingValue}/5`, l: 'note moyenne de nos clients' },
      ].map((stat) => (
        <div class="rounded-xl p-5" style="background-color: var(--color-surface); border: 1px solid var(--color-border)">
          <p class="font-display text-3xl font-semibold" style="color: var(--color-accent)">{stat.n}</p>
          <p class="text-xs mt-1" style="color: var(--color-text-muted)">{stat.l}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
