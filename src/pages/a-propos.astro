---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { aggregateRating } from '../content/testimonials';

const { primaryKeyword, name, city } = siteConfig.identity;
---
<Layout
  title={`À propos — ${name}, ${primaryKeyword} à ${city}`}
  description={`L'histoire de ${name}, ${primaryKeyword} à ${city} : recettes familiales, épices importées et cuisson au tandoor traditionnel.`}
  path="/a-propos"
>
  <PageHero
    kicker="Notre histoire"
    title={`À propos de ${name}`}
    image="/images/interior-1.jpg"
    alt={`Intérieur du ${primaryKeyword} ${name}`}
  />
  <section class="relative max-w-3xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-20 overflow-hidden">
    <!-- Large faded emblem behind the copy — the real gold mark, not a
         generic decorative shape, used at a scale it can never appear at
         in the header. A quiet "wow" texture instead of another flat
         paragraph block. -->
    <img
      src="/images/logo-mark.png"
      alt=""
      aria-hidden="true"
      class="mark-watermark w-[26rem] h-[26rem] -right-32 -top-16 sm:-right-24"
    />
    <div class="relative space-y-5 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)" data-reveal>
      <p>
        {name} est né d'une conviction simple : {city} méritait un {primaryKeyword} qui ne transige ni sur les
        épices, ni sur les techniques de cuisson traditionnelles. Pas de recettes édulcorées pour le marché local —
        le même goût que celui que l'on trouve dans les cuisines familiales du nord de l'Inde.
      </p>
      <p>
        Notre four tandoor en argile, chauffé au charbon, est au centre de la cuisine : c'est lui qui donne aux
        pains naan leur croûte caractéristique et aux grillades leur fumé si particulier. Chaque plat est préparé à
        la commande, jamais à l'avance.
      </p>
      <p>
        Les épices sont importées directement, moulues sur place, et nos recettes suivent celles transmises depuis
        plusieurs générations. C'est ce soin, plus que n'importe quel argument marketing, qui fait revenir nos
        clients.
      </p>
    </div>

    <!-- Oversized, unboxed numbers instead of three identical grey tiles —
         same information, but the numbers themselves now carry the visual
         weight instead of a card border doing the work. -->
    <div class="relative mt-14 grid sm:grid-cols-3 gap-8 sm:gap-6">
      {[
        { n: '10+', l: "ans d'expérience en cuisine indienne" },
        { n: '100%', l: 'plats préparés à la commande' },
        { n: `${aggregateRating.ratingValue}/5`, l: 'note moyenne de nos clients' },
      ].map((stat, i) => (
        <div
          class="pb-6 sm:pb-0 sm:pl-6"
          style={`border-bottom: 1px solid var(--color-border); border-left: ${i === 0 ? 'none' : '1px solid var(--color-border)'}; transition-delay: ${i * 100}ms`}
          data-reveal
        >
          <p class="stat-huge">{stat.n}</p>
          <p class="text-xs mt-2" style="color: var(--color-text-muted)">{stat.l}</p>
        </div>
      ))}
    </div>
  </section>

  <Ornament />
</Layout>
