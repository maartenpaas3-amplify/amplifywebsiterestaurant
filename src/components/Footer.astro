---
import { siteConfig } from '../config/site.config';
import { orderCtaLabel } from '../lib/nav';
import Button from './Button.astro';

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/menu', label: 'Menu' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/avis', label: 'Avis' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
---
<footer style="background-color: var(--color-surface); border-top: 1px solid var(--color-border)">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 grid sm:grid-cols-3 gap-10">
    <div>
      <span class="text-[11px] font-bold uppercase tracking-[0.2em]" style="color: var(--color-accent)">
        {siteConfig.identity.city}
      </span>
      <h3 class="font-display text-2xl font-semibold mt-1.5" style="color: var(--color-text-primary)">
        {siteConfig.identity.name}
      </h3>
      <p class="text-sm mt-2 max-w-xs" style="color: var(--color-text-muted)">
        {siteConfig.identity.tagline}
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href={orderCtaLabel.href} external>{orderCtaLabel.label}</Button>
        {siteConfig.contact.instagramUrl && (
          <a
            href={siteConfig.contact.instagramUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Indian Flavors sur Instagram"
            class="footer-social inline-flex items-center justify-center w-11 h-11 rounded-full transition-colors"
            style="border: 1.5px solid var(--color-border); color: var(--color-text-muted)"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
            </svg>
          </a>
        )}
        {siteConfig.contact.facebookUrl && (
          <a
            href={siteConfig.contact.facebookUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Indian Flavors sur Facebook"
            class="footer-social inline-flex items-center justify-center w-11 h-11 rounded-full transition-colors"
            style="border: 1.5px solid var(--color-border); color: var(--color-text-muted)"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path
                d="M15 8.5h-2c-.55 0-1 .45-1 1V12h3l-.4 3H12v7h-3v-7H7v-3h2V9.2C9 6.9 10.4 5.5 12.5 5.5H15v3z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )}
      </div>
    </div>

    <div class="space-y-3 text-sm" style="color: var(--color-text-muted)">
      <p>{siteConfig.contact.address}</p>
      <p><a href={siteConfig.contact.phoneHref} class="hover:underline">{siteConfig.contact.phoneDisplay}</a></p>
      <p>{siteConfig.contact.openingHours}</p>
    </div>

    <nav class="flex flex-col gap-2.5 sm:items-end text-sm">
      {nav.map((item) => (
        <a href={item.href} style="color: var(--color-text-muted)" class="hover:underline">
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <div style="border-top: 1px solid var(--color-border)">
    <p class="text-center text-[11px] py-4" style="color: var(--color-text-muted)">
      {siteConfig.identity.name} · {new Date().getFullYear()} · Built by Amplify Growth Studio ·{' '}
      <a href="/confidentialite" class="hover:underline">Confidentialité</a>
    </p>
  </div>
</footer>

<style>
  .footer-social:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
