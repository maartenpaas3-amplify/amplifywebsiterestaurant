---
// The studio's one primary-action button — same "quiet luxury" outline
// treatment as the order-landing-page engine's MagneticButton: transparent
// at rest, a solid fill sweeps in from the left on hover/press, label
// switches to background color to stay legible. No framer-motion runtime
// here (static site, no JS by default) — the exact same visual result is
// achieved with a pure CSS transition on a pseudo-element instead.
// `cta` is a new third variant (Point 5 of the "give it more flair" pass):
// the outline/filled pair reads as quiet-luxury-minimal, correct for most
// buttons, but the ONE button that makes the restaurant money — the order
// CTA — was disappearing into that same quiet treatment. `cta` gives it a
// red-to-gold gradient (finally putting the brand's actual primary red to
// use instead of it sitting unused in the token file) and a soft glow on
// hover, so it reads as the obvious next click instead of one option among
// equals.
interface Props {
  href: string;
  external?: boolean;
  variant?: 'outline' | 'filled' | 'cta';
  class?: string;
}
const { href, external = false, variant = 'outline', class: className = '' } = Astro.props;
const variantClass = variant === 'outline' ? 'amp-btn-outline' : variant === 'cta' ? 'amp-btn-cta' : 'amp-btn-filled';
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  class:list={[
    'amp-btn relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-lg px-7 py-4 text-sm font-bold tracking-wide transition-all duration-200',
    variantClass,
    className,
  ]}
>
  <span class="relative z-10 inline-flex items-center gap-2">
    <slot />
    {variant === 'cta' && (
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" class="amp-btn-arrow">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
  </span>
</a>

<style>
  .amp-btn-outline {
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
    background-color: transparent;
  }
  .amp-btn-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }
  .amp-btn-outline:hover::before,
  .amp-btn-outline:active::before {
    transform: scaleX(1);
  }
  .amp-btn-outline:hover,
  .amp-btn-outline:active {
    color: var(--color-background);
  }
  .amp-btn-filled {
    background-color: var(--color-accent);
    color: var(--color-background);
  }
  .amp-btn-filled:hover {
    filter: brightness(1.08);
  }

  .amp-btn-cta {
    background: linear-gradient(100deg, var(--color-primary) 0%, var(--color-primary) 35%, var(--color-accent) 100%);
    color: #fff;
    box-shadow: 0 4px 18px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .amp-btn-cta:hover {
    box-shadow: 0 6px 26px color-mix(in srgb, var(--color-primary) 55%, transparent), 0 0 0 1px color-mix(in srgb, var(--color-accent) 60%, transparent);
    transform: translateY(-1px);
  }
  .amp-btn-arrow {
    transition: transform 0.2s ease;
  }
  .amp-btn-cta:hover .amp-btn-arrow {
    transform: translateX(3px);
  }
</style>
